Options -MultiViews
RewriteEngine On

# Map clean URLs to HTML files
RewriteRule ^about-us/?$ about.html [L,QSA]
RewriteRule ^contact-us/?$ contact.html [L,QSA]
RewriteRule ^products/?$ products.html [L,QSA]
RewriteRule ^gallery/?$ gallery.html [L,QSA]
RewriteRule ^product-details/?$ product-details.html [L,QSA]

# Automatically strip .html extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^\.]+)/?$ $1.html [L,QSA]
